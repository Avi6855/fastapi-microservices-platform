MEDIA_DATABASE_URL=postgresql+asyncpg://media_service:media-local-only@localhost:5432/media_service
MEDIA_JWT_SECRET=replace-with-a-secret-at-least-32-characters-long
MEDIA_CHAT_ACCESS_SECRET=replace-with-a-secret-at-least-32-characters-long
MEDIA_S3_ENDPOINT_URL=http://localhost:9000
MEDIA_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
MEDIA_RABBITMQ_URL=amqp://platform:platform-local-only@localhost:5672//
MEDIA_KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# Object storage provider: s3 (default) or azure.
MEDIA_OBJECT_STORAGE_PROVIDER=s3
# Only read when MEDIA_OBJECT_STORAGE_PROVIDER=azure.
MEDIA_AZURE_STORAGE_ACCOUNT_URL=http://127.0.0.1:10000/devstoreaccount1
MEDIA_AZURE_STORAGE_ACCOUNT_NAME=devstoreaccount1
MEDIA_AZURE_STORAGE_ACCOUNT_KEY=replace-with-the-storage-account-key
MEDIA_AZURE_STORAGE_CONTAINER=fastapi-platform-media
MEDIA_AZURE_STORAGE_PUBLIC_ENDPOINT_URL=http://127.0.0.1:10000/devstoreaccount1
